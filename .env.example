# WorkWise Environment Configuration Template
# Copy this file to .env and fill in your values.

# Supabase Public Configuration (Safe to expose to frontend client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Server-Side API Secrets (NEVER prefix with VITE_ to prevent bundling into client-side JS)
# Used by Vercel serverless functions / local dev server proxy for AI Assistant
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Dedicated Stress Detection Microservice URL (if self-hosted)
# VITE_STRESS_API_URL=https://your-stress-api.example.com
